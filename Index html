                    <i class="fas fa-envelope"></i>
                    <h3>Email</h3>
                    <p>info@relojeriaspilar.com</p>
                </div>
                <div class="contact-item">
                    <i class="fas fa-map-marker-alt"></i>
                    <h3>Dirección</h3>
                    <p>Calle Comercio 123, La Paz, Bolivia</p>
                </div>
                <div class="contact-item">
                    <i class="fas fa-clock"></i>
                    <h3>Horario</h3>
                    <p>Lun-Vie: 9:00-18:00</p>
                </div>
            </div>
            <form>
                <input type="text" placeholder="Nombre" required>
                <input type="email" placeholder="Email" required>
                <textarea placeholder="Mensaje" rows="5" required></textarea>
                <button class="btn-3d" type="submit">Enviar</button>
            </form>
            <iframe id="map" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3825.0000!2d-68.1193!3d-16.5000!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMTYuNTAwMCwtNjguMTE5Mw!5e0!3m2!1ses!2sbo!4v1234567890123!5m2!1ses!2sbo" allowfullscreen="" loading="lazy"></iframe>
        </div>
    </section>

    <!-- Footer premium -->
    <footer>
        <div class="social-links">
            <a href="#"><i class="fab fa-facebook"></i></a>
            <a href="#"><i class="fab fa-instagram"></i></a>
            <a href="#"><i class="fab fa-twitter"></i></a>
        </div>
        <p>&copy; 2023 Relojerías Pilar. Todos los derechos reservados.</p>
    </footer>

    <!-- Back to top -->
    <button class="back-to-top" onclick="scrollToTop()">↑</button>

    <script>
        // Loader premium
        window.addEventListener('load', () => {
            setTimeout(() => {
                document.getElementById('loader').classList.add('hidden');
            }, 2000);
        });

        // Partículas premium
        function createParticles() {
            const particlesContainer = document.getElementById('particles');
            for (let i = 0; i < 50; i++) {
                const particle = document.createElement('div');
                particle.className = 'particle';
                particle.style.left = Math.random() * 100 + '%';
                particle.style.animationDelay = Math.random() * 15 + 's';
                particlesContainer.appendChild(particle);
            }
        }
        createParticles();

        // Three.js para Hero: Reloj 3D girando
        const heroScene = new THREE.Scene();
        const heroCamera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
        const heroRenderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
        heroRenderer.setSize(window.innerWidth, window.innerHeight);
        document.getElementById('threejs-hero').appendChild(heroRenderer.domElement);

        // Reloj simple (cilindro + esfera)
        const geometry = new THREE.CylinderGeometry(1, 1, 0.1, 32);
        const material = new THREE.MeshStandardMaterial({ color: 0xD4AF37, metalness: 0.8, roughness: 0.2 });
        const clock = new THREE.Mesh(geometry, material);
        heroScene.add(clock);

        // Luces
        const light = new THREE.DirectionalLight(0xffffff, 1);
        light.position.set(5, 5, 5);
        heroScene.add(light);

        heroCamera.position.z = 5;

        function animateHero() {
            requestAnimationFrame(animateHero);
            clock.rotation.y += 0.01;
            heroRenderer.render(heroScene, heroCamera);
        }
        animateHero();

        // Three.js para Collection: Modelo 3D interactivo
        const collScene = new THREE.Scene();
        const collCamera = new THREE.PerspectiveCamera(75, 800 / 600, 0.1, 1000);
        const collRenderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
        collRenderer.setSize(800, 600);
        document.getElementById('threejs-collection').appendChild(collRenderer.domElement);

        // Modelo simple (cubo como placeholder para reloj)
        const collGeometry = new THREE.BoxGeometry(1, 1, 1);
        const collMaterial = new THREE.MeshStandardMaterial({ color: 0xA0A0A0, metalness: 0.5 });
        const watch = new THREE.Mesh(collGeometry, collMaterial);
        collScene.add(watch);
        collScene.add(new THREE.DirectionalLight(0xffffff, 1));

        collCamera.position.z = 5;

        function animateColl() {
            requestAnimationFrame(animateColl);
            watch.rotation.x += 0.01;
            watch.rotation.y += 0.01;
            collRenderer.render(collScene, collCamera);
        }
        animateColl();

        // GSAP para animaciones premium
        gsap.registerPlugin(ScrollTrigger);

        // Animaciones en scroll
        gsap.from('.hero-text', { duration: 3, y: 50, opacity: 0, ease: 'power2.out' });
        gsap.to('.timeline-item', {
            scrollTrigger: {
                trigger: '#history',
                start: 'top center',
                end: 'bottom center',
                scrub: true
            },
            opacity: 1,
            y: 0,
            rotationX: 0,
            stagger: 0.3
        });

        // Conteo animado en stats
        gsap.to('.stat', {
            innerText: (i, target) => target.dataset.target,
            duration: 3,
            ease: 'power2.out',
            snap: { innerText: 1 }
        });

        // Filtros en colección
        const filterButtons = document.querySelectorAll('.filter-btn');
        const cards = document.querySelectorAll('.card[data-category]');
        filterButtons.forEach(btn => {
            btn.addEventListener('click', () => {
                filterButtons.forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                const filter = btn.dataset.filter;
                cards.forEach(card => {
                    if (filter === 'all' || card.dataset.category === filter) {
                        card.style.display = 'block';
                    } else {
                        card.style.display = 'none';
                    }
                });
            });
        });

             // Scroll suave
        function scrollToSection(id) {
            gsap.to(window, { duration: 1.5, scrollTo: `#${id}`, ease: 'power2.inOut' });
        }

        // Toggle menu para móviles
        function toggleMenu() {
            const sidebar = document.getElementById('sidebar');
            sidebar.classList.toggle('show');
        }

        // Scroll to top
        function scrollToTop() {
            gsap.to(window, { duration: 1.5, scrollTo: 0, ease: 'power2.inOut' });
        }

        // Responsive para Three.js
        window.addEventListener('resize', () => {
            heroCamera.aspect = window.innerWidth / window.innerHeight;
            heroCamera.updateProjectionMatrix();
            heroRenderer.setSize(window.innerWidth, window.innerHeight);

            collCamera.aspect = 800 / 600;
            collCamera.updateProjectionMatrix();
            collRenderer.setSize(800, 600);
        });

        // Validación básica de formulario
        const form = document.querySelector('form');
        form.addEventListener('submit', (e) => {
            e.preventDefault();
            alert('Mensaje enviado. ¡Gracias por contactarnos!');
            form.reset();
        });
    </script>
    <!-- Font Awesome para íconos -->
    <script src="https://kit.fontawesome.com/a076d05399.js"></script>
</body>
</html>
