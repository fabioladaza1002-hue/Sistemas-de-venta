<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Relojerías Pilar: Experiencia premium de lujo en relojería. Relojes de alta gama con diseño 3D exclusivo.">
    <title>Relojerías Pilar - Lujo en el Tiempo</title>
    <style>
        /* Reset y estilos base premium */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Playfair Display', serif; /* Serif premium para títulos */
            background: linear-gradient(135deg, #0B0B0B, #1A1A1A);
            color: #C9A24D;
            overflow-x: hidden;
            line-height: 1.6;
            backdrop-filter: blur(1px);
        }
        h1, h2, h3 {
            font-weight: 700;
            letter-spacing: 3px;
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.7);
            color: #D4AF37;
        }
        p, span {
            font-family: 'Montserrat', sans-serif; /* Sans moderna para texto */
            color: #E0E0E0;
        }
        canvas {
            display: block;
        }
        /* Loader premium inicial */
        #loader {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: #0B0B0B;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            animation: fadeOut 3s ease-out forwards;
        }
        #loader.hidden {
            display: none;
        }
        .loader-content {
            text-align: center;
            color: #D4AF37;
        }
        .loader-content h1 {
            font-size: 3rem;
            animation: pulse 2s infinite;
        }
        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }
        @keyframes fadeOut {
            to { opacity: 0; visibility: hidden; }
        }
        /* Partículas premium */
        .particles {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: -1;
        }
        .particle {
            position: absolute;
            background: radial-gradient(circle, #D4AF37 0%, transparent 70%);
            border-radius: 50%;
            opacity: 0.2;
            animation: floatPremium 15s infinite linear;
        }
        @keyframes floatPremium {
            0% { transform: translateY(100vh) rotate(0deg); }
            100% { transform: translateY(-100px) rotate(360deg); }
        }
        /* Header premium */
        header {
            position: fixed;
            top: 0;
            width: 100%;
            background: rgba(11, 11, 11, 0.98);
            padding: 1.5rem 3rem;
            z-index: 1000;
            display: flex;
            justify-content: center;
            align-items: center;
            backdrop-filter: blur(20px);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.8);
            border-bottom: 1px solid #D4AF37;
        }
        .logo {
            font-size: 2rem;
            font-weight: bold;
            color: #D4AF37;
            text-transform: uppercase;
            letter-spacing: 5px;
        }
        nav ul {
            list-style: none;
            display: flex;
            gap: 3rem;
            margin-left: 3rem;
        }
        nav a {
            color: #C9A24D;
            text-decoration: none;
            transition: all 0.4s ease;
            position: relative;
            font-size: 1.1rem;
        }
        nav a:hover {
            color: #E0E0E0;
            transform: translateY(-2px);
        }
        nav a::after {
            content: '';
            position: absolute;
            bottom: -5px;
            left: 0;
            width: 0;
            height: 2px;
            background: linear-gradient(90deg, #D4AF37, #C9A24D);
            transition: width 0.4s ease;
        }
        nav a:hover::after {
            width: 100%;
        }
        .menu-toggle {
            display: none;
            cursor: pointer;
            font-size: 1.5rem;
            color: #D4AF37;
        }
        /* Sidebar premium */
        .sidebar {
            position: fixed;
            right: 0;
            top: 50%;
            transform: translateY(-50%);
            background: rgba(11, 11, 11, 0.95);
            padding: 2rem;
            border-radius: 15px 0 0 15px;
            box-shadow: -5px 0 20px rgba(0, 0, 0, 0.8);
            display: none;
            border-left: 2px solid #D4AF37;
        }
        .sidebar.show {
            display: block;
        }
        .sidebar a {
            display: block;
            color: #C9A24D;
            margin: 1rem 0;
            text-decoration: none;
            transition: color 0.3s ease;
        }
        .sidebar a:hover {
            color: #E0E0E0;
        }
        /* Secciones premium */
        section {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 6rem 3rem;
            position: relative;
            background: linear-gradient(135deg, rgba(11, 11, 11, 0.9), rgba(26, 26, 26, 0.9));
            margin: 2rem;
            border-radius: 20px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
        }
        .section-content {
            max-width: 1400px;
            width: 100%;
            text-align: center;
        }
        /* Hero premium */
        #hero {
            background: linear-gradient(135deg, #0B0B0B, #1A1A1A);
            overflow: hidden;
            position: relative;
            border: none;
        }
        .hero-bg {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: url('https://images.unsplash.com/photo-1508685096489-7aacd43bd3b1?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80') no-repeat center center;
            background-size: cover;
            opacity: 0.4;
            animation: parallaxPremium 25s ease-in-out infinite alternate;
        }
        #hero canvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
        }
        .hero-text {
            z-index: 10;
            text-align: center;
            animation: fadeInPremium 3s ease-out;
        }
        .hero-text h1 {
            font-size: 5rem;
            margin-bottom: 1.5rem;
            background: linear-gradient(45deg, #D4AF37, #C9A24D);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .hero-text p {
            font-size: 1.8rem;
            margin-bottom: 3rem;
            opacity: 0.9;
        }
        .btn-3d {
            background: linear-gradient(45deg, #D4AF37, #A08B3D);
            color: #0B0B0B;
            padding: 1.5rem 3rem;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            font-weight: bold;
            font-size: 1.2rem;
            box-shadow: 0 8px 25px rgba(212, 175, 55, 0.4);
            transition: all 0.4s ease;
            position: relative;
            overflow: hidden;
        }
        .btn-3d::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: left 0.5s ease;
        }
        .btn-3d:hover::before {
            left: 100%;
        }
        .btn-3d:hover {
            transform: translateY(-5px) scale(1.05);
            box-shadow: 0 15px 35px rgba(212, 175, 55, 0.6);
        }
        /* Cards premium */
        .card {
            background: rgba(26, 26, 26, 0.95);
            border-radius: 15px;
            padding: 3rem;
            margin: 1.5rem;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.7);
            border: 1px solid #D4AF37;
            transition: all 0.5s ease;
            position: relative;
            overflow: hidden;
        }
        .card::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(212, 175, 55, 0.1), transparent);
            transition: left 0.6s ease;
        }
        .card:hover::before {
            left: 100%;
        }
        .card:hover {
            transform: translateY(-10px) scale(1.02);
            box-shadow: 0 15px 50px rgba(0, 0, 0, 0.9);
        }
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 3rem;
        }
        .timeline {
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .timeline-item {
            margin: 3rem 0;
            opacity: 0;
            transform: translateY(50px) rotateX(10deg);
            transition: all 1.2s ease;
        }
        .timeline-item.visible {
            opacity: 1;
            transform: translateY(0) rotateX(0);
        }
        /* Imágenes premium en movimiento */
        .product-img {
            width: 100%;
            height: auto;
            border-radius: 15px;
            transition: all 0.6s ease;
            animation: floatProductPremium 8s ease-in-out infinite;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.5);
        }
        .product-img:hover {
            transform: scale(1.15) rotate(3deg);
            box-shadow: 0 10px 40px rgba(212, 175, 55, 0.3);
        }
        @keyframes floatProductPremium {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            50% { transform: translateY(-15px) rotate(1deg); }
        }
        .gallery-carousel {
            display: flex;
            overflow-x: auto;
            scroll-snap-type: x mandatory;
            gap: 2rem;
        }
        .gallery-item {
            min-width: 350px;
            scroll-snap-align: start;
            border-radius: 15px;
            overflow: hidden;
            transition: all 0.5s ease;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.5);
        }
        .gallery-item:hover {
            transform: scale(1.1) rotateY(5deg);
        }
        .gallery-item img {
            width: 100%;
            height: auto;
            display: block;
            animation: slideInPremium 1.5s ease-out;
        }
        @keyframes slideInPremium {
            from { transform: translateX(100px) scale(0.9); opacity: 0; }
            to { transform: translateX(0) scale(1); opacity: 1; }
        }
        /* Filtros premium en colección */
        .filters {
            display: flex;
            justify-content: center;
            gap: 2rem;
            margin-bottom: 3rem;
        }
        .filter-btn {
            background: rgba(26, 26, 26, 0.9);
            color: #C9A24D;
            border: 1px solid #D4AF37;
            padding: 1rem 2rem;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.4s ease;
        }
        .filter-btn:hover, .filter-btn.active {
            background: #D4AF37;
            color: #0B0B0B;
            transform: translateY(-3px);
        }
        /* Contacto premium */
        .contact-info {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 3rem;
            margin-bottom: 3rem;
        }
        .contact-item {
            text-align: center;
            background: rgba(26, 26, 26, 0.9);
            padding: 2rem;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.5);
            border: 1px solid #D4AF37;
        }
        .contact-item i {
            font-size: 2.5rem;
            color: #D4AF37;
            margin-bottom: 1rem;
        }
        form {
            max-width: 700px;
            width: 100%;
            margin: 0 auto;
        }
        input, textarea {
            width: 100%;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
            background: rgba(26, 26, 26, 0.9);
            border: 1px solid #D4AF37;
            color: #E0E0E0;
            border-radius: 10px;
            font-family: 'Montserrat', sans-serif;
            font-size: 1.1rem;
            transition: border-color 0.3s ease;
        }
        input:focus, textarea:focus {
            outline: none;
            border-color: #E0E0E0;
            box-shadow: 0 0 10px rgba(212, 175, 55, 0.5);
        }
        #map {
            width: 100%;
            height: 350px;
            border-radius: 15px;
            margin-top: 3rem;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.5);
        }
        /* Footer premium */
        footer {
            background: #0B0B0B;
            padding: 3rem;
            text-align: center;
            color: #A0A0A0;
            border-top: 1px solid #D4AF37;
        }
        .social-links {
            display: flex;
            justify-content: center;
            gap: 2rem;
            margin-bottom: 2rem;
        }
        .social-links a {
            color: #C9A24D;
            font-size: 1.5rem;
            transition: color 0.3s ease;
        }
        .social-links a:hover {
            color: #D4AF37;
        }
        .back-to-top {
            position: fixed;
            bottom: 3rem;
            right: 3rem;
            background: linear-gradient(45deg, #D4AF37, #A08B3D);
            color: #0B0B0B;
            border: none;
            border-radius: 50%;
            width: 60px;
            height: 60px;
            cursor: pointer;
            box-shadow: 0 5px 20px rgba(212, 175, 55, 0.4);
            transition: all 0.4s ease;
            font-size: 1.5rem;
        }
        .back-to-top:hover {
            transform: scale(1.1) translateY(-5px);
            box-shadow: 0 10px 30px rgba(212, 175, 55, 0.6);
        }
        /* Responsive premium */
        @media (max-width: 768px) {
            .hero-text h1 { font-size: 3rem; }
            nav ul { display: none; }
            .menu-toggle { display: block; }
            .sidebar { display: block; position: static; transform: none; margin-top: 2rem; }
            .grid { grid-template-columns: 1fr; }
            .contact-info { flex-direction: column; }
            .filters { flex-direction: column; gap: 1rem; }
        }
        /* Animaciones premium */
        @keyframes fadeInPremium {
            from { opacity: 0; transform: translateY(30px) scale(0.95); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }
               @keyframes parallaxPremium {
            0% { transform: translateY(0) scale(1); }
            50% { transform: translateY(-10px) scale(1.02); }
            100% { transform: translateY(0) scale(1); }
        }
    </style>
    <!-- Librerías -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Montserrat:wght@300;400;700&display=swap" rel="stylesheet">
</head>
